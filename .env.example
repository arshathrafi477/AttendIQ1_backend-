# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────
# Option A: individual fields (local development)
PGHOST=localhost
PGPORT=5432
PGDATABASE=attendiq
PGUSER=postgres
PGPASSWORD=postgres

# Option B: single connection string (used by Render, Railway, Heroku, etc.)
# If DATABASE_URL is set, it takes priority over the PG* fields above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "true" when connecting to a managed Postgres that requires SSL
# (Render, Railway, Heroku, Supabase, etc. all need this set to true).
DB_SSL=false

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all (dev only).
CORS_ORIGIN=http://localhost:3000
